# Generates a C++ header that embeds UI assets as raw string literals.
# Files are original Tempo assets; no external content is fetched.

if(NOT DEFINED OUT OR NOT DEFINED ROOT OR NOT DEFINED FILES)
  message(FATAL_ERROR "EmbedAssets.cmake requires OUT, ROOT and FILES")
endif()

set(_entries "")
foreach(_file IN LISTS FILES)
  file(READ "${_file}" _content)
  get_filename_component(_name "${_file}" NAME)
  string(FIND "${_content}" ")TEMPOASSET\"" _hit)
  if(NOT _hit EQUAL -1)
    message(FATAL_ERROR "Asset ${_name} contains the reserved delimiter")
  endif()
  string(APPEND _entries
    "  {\"${_name}\", R\"TEMPOASSET(${_content})TEMPOASSET\"},\n")
endforeach()

file(WRITE "${OUT}.tmp"
"// Generated by cmake/EmbedAssets.cmake. Do not edit.\n"
"#pragma once\n"
"#include <cstddef>\n"
"#include <string_view>\n"
"namespace tempo::assets {\n"
"struct Asset { std::string_view name; std::string_view body; };\n"
"inline constexpr Asset kAssets[] = {\n${_entries}};\n"
"inline constexpr std::size_t kAssetCount = sizeof(kAssets) / sizeof(kAssets[0]);\n"
"}\n")
file(RENAME "${OUT}.tmp" "${OUT}")
